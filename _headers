# HTML은 매번 최신 확인 (배포 후 옛 화면 방지)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 이미지는 장기 캐시
/assets/*
  Cache-Control: public, max-age=31536000

# 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
