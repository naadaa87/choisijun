# HTML은 매번 최신 확인 (배포 후 옛 화면 방지)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 검색엔진용 파일도 매번 최신
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/rss.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

# 인사이트 글 페이지도 매번 최신
/insights/*
  Cache-Control: public, max-age=0, must-revalidate

# 원고·조각 파일은 검색 결과에 나오지 않게
/fragments/*
  X-Robots-Tag: noindex
/content/*
  X-Robots-Tag: noindex
/data/*
  X-Robots-Tag: noindex
/setup/*
  X-Robots-Tag: noindex

# 설정 파일은 늘 최신으로 (키를 바꾸면 바로 반영)
/site-config.js
  Cache-Control: public, max-age=0, must-revalidate

# 이미지·영상은 장기 캐시
/assets/*
  Cache-Control: public, max-age=31536000

# 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# pages.dev 주소는 검색에 나오지 않게 (공식 주소 choisijun.com 으로 모으기)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
